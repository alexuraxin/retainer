#!/usr/bin/env bash
# Scan for hardcoded secrets in the TREE/HEAD. Called by gate.sh (step secret_scan) and by a test (test_secret_scan).
# Not runtime exfiltration (the egress guard catches that), but a credential VALUE committed to git.
# Arguments: <repo_dir> <level: basic|thorough|false>. Finding → exit 1. Mark a fake fixture '# retainer:allow-secret'.
# Boundary: git grep = tree/HEAD, NOT the push range (a secret added-and-removed within an unpushed range
# is not seen — a deliberate boundary of the lite port). Narrow prefixes (low FP).
set -uo pipefail
DIR="${1:-.}"; LEVEL="${2:-basic}"
cd "$DIR" 2>/dev/null || { echo "  secret_scan: no directory $DIR — skipping"; exit 0; }
[ "$LEVEL" = false ] && exit 0

PAT='AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]{8,}\.[A-Za-z0-9_-]+'
[ "$LEVEL" = thorough ] && PAT="$PAT"'|(secret|password|passwd|token|api[_-]?key|access[_-]?key)[[:space:]]*[:=][[:space:]]*['"'"'"][^'"'"'"]{8,}'

# git grep = tree/HEAD; excludes lock files and the sweep journal; `# retainer:allow-secret` on a line clears a FP.
hits="$(git grep -nIE "$PAT" -- . ':(exclude).retainer/bypass.log' ':(exclude)*.lock' ':(exclude)*-lock.json' 2>/dev/null | grep -vi 'retainer:allow-secret' || true)"
if [ -n "$hits" ]; then
  echo "  ✗ looks like a hardcoded secret in tracked files:"
  printf '%s\n' "$hits" | sed 's/^/    /'
  echo "  Move the secret out of the code (env/secret manager). Mark a fake fixture '# retainer:allow-secret'."
  exit 1
fi
echo "  secret_scan — clean ✓"
exit 0
