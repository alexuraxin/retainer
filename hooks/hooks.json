{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/retainer-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/session_context.py\"",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/retainer-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/guard_discipline.py\"",
            "async": false
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/retainer-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/write_advice.py\"",
            "async": false
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/retainer-python\" \"${CLAUDE_PLUGIN_ROOT}/hooks/stop_gate.py\"",
            "async": false,
            "timeout": 600
          }
        ]
      }
    ]
  }
}
